{
  "$schema": "https://sentiae.com/schemas/node-manifest/v1.json",
  "capabilities": {
    "egress": []
  },
  "category": "branch",
  "config": {
    "additionalProperties": false,
    "properties": {
      "pattern": {
        "default": "",
        "type": "string"
      },
      "type": {
        "default": "url",
        "enum": [
          "url",
          "regex",
          "non_empty"
        ],
        "type": "string"
      }
    },
    "type": "object"
  },
  "display": {
    "description": "Validates a value and routes it through exactly one valid or invalid output.",
    "icon": "check-circle",
    "name": "Validate"
  },
  "implementations": {
    "go": {
      "entry": "go/node.go",
      "lockfiles": [
        "go/go.mod",
        "go/go.sum"
      ]
    },
    "typescript": {
      "entry": "typescript/src/node.ts",
      "lockfiles": [
        "typescript/package-lock.json"
      ]
    }
  },
  "inputs": [
    {
      "description": "Value to validate.",
      "name": "value",
      "required": true,
      "schema": {}
    }
  ],
  "name": "@sentiae/validate",
  "outputs": [
    {
      "description": "The value when validation succeeds.",
      "name": "valid",
      "required": false,
      "schema": {}
    },
    {
      "description": "The value when validation fails.",
      "name": "invalid",
      "required": false,
      "schema": {}
    }
  ],
  "resources": {
    "memoryMiB": 64,
    "timeoutMs": 5000
  },
  "role": null,
  "secrets": [],
  "shape": "inline"
}
