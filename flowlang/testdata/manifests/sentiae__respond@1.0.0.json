{
  "$schema": "https://sentiae.com/schemas/node-manifest/v1.json",
  "capabilities": {
    "egress": []
  },
  "category": "output",
  "config": {
    "additionalProperties": false,
    "properties": {
      "status": {
        "default": 200,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "display": {
    "description": "Returns the inbound value as the flow's HTTP response.",
    "icon": "log-out",
    "name": "Respond"
  },
  "implementations": {
    "go": {
      "entry": "go/node.go",
      "lockfiles": [
        "go/go.mod",
        "go/go.sum"
      ]
    },
    "typescript": {
      "entry": "typescript/src/node.ts",
      "lockfiles": [
        "typescript/package-lock.json"
      ]
    }
  },
  "inputs": [
    {
      "description": "Payload returned as the response body.",
      "name": "body",
      "required": true,
      "schema": {}
    }
  ],
  "name": "@sentiae/respond",
  "outputs": [
    {
      "description": "The HTTP response returned by the flow.",
      "name": "response",
      "required": true,
      "schema": {
        "additionalProperties": false,
        "properties": {
          "body": {},
          "headers": {
            "type": "object"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  ],
  "resources": {
    "memoryMiB": 64,
    "timeoutMs": 5000
  },
  "role": "respond",
  "secrets": [],
  "shape": "inline"
}
