{
  "$schema": "https://sentiae.com/schemas/node-manifest/v1.json",
  "capabilities": {
    "egress": []
  },
  "category": "trigger",
  "config": {
    "additionalProperties": false,
    "properties": {
      "method": {
        "default": "POST",
        "enum": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ],
        "type": "string"
      },
      "path": {
        "default": "/webhook",
        "type": "string"
      }
    },
    "type": "object"
  },
  "display": {
    "description": "Starts a flow when an HTTP request arrives and emits the request fields.",
    "icon": "zap",
    "name": "Webhook Trigger"
  },
  "implementations": {
    "go": {
      "entry": "go/node.go",
      "lockfiles": [
        "go/go.mod",
        "go/go.sum"
      ]
    },
    "typescript": {
      "entry": "typescript/src/node.ts",
      "lockfiles": [
        "typescript/package-lock.json"
      ]
    }
  },
  "inputs": [],
  "name": "@sentiae/webhook-trigger",
  "outputs": [
    {
      "description": "Parsed request body when present.",
      "name": "body",
      "required": false,
      "schema": {}
    },
    {
      "description": "Request headers.",
      "name": "headers",
      "required": true,
      "schema": {
        "type": "object"
      }
    },
    {
      "description": "Query-string parameters.",
      "name": "query",
      "required": true,
      "schema": {
        "type": "object"
      }
    },
    {
      "description": "HTTP request method.",
      "name": "method",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "HTTP request path.",
      "name": "path",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "resources": {
    "memoryMiB": 64,
    "timeoutMs": 5000
  },
  "role": "trigger",
  "secrets": [],
  "shape": "inline"
}
