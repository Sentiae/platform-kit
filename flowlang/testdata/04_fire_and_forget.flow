flow "Audit sink" v2

use secure_http = @acme/secure-http@2.1.0
use webhook_trigger = @sentiae/webhook-trigger@1.0.0

node intake: webhook_trigger {
}

node audit: secure_http {
	url = "https://api.example.net/audit"
}

wire intake.body -> audit.payload

layout {
	intake @ 80,100
	audit @ 400,100
}
